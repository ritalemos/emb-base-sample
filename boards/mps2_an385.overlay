#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		button0 = &button0;
		button1 = &button1;
	};

	gpio_sim: gpio_sim {
		compatible = "zephyr,gpio-emul";
		status = "okay";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <32>;

		rising-edge;
		falling-edge;
		high-level;
		low-level;
	};

	gpio_keys {
		compatible = "gpio-keys";
		debounce-interval-ms = <20>;

		button0: button_0 {
			gpios = <&gpio_sim 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};

		button1: button_1 {
			gpios = <&gpio_sim 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};

    chosen {
        zephyr,display = &dummy_dc;
    };

    dummy_dc: dummy_dc {
        compatible = "zephyr,dummy-dc";
        status = "okay";
        width = <80>;
        height = <24>;
    };
};
