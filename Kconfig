source "Kconfig.zephyr"

menu "Speed Radar Configuration"

config DISPLAY_ANSI_COLORS
    bool "Enable ANSI colors in display"
    default y
    help
      Enable colored output for status display (green/yellow/red).

config RADAR_SENSOR_DISTANCE_MM
    int "Distance between radar sensors (mm)"
    range 1000 100000
    default 3000
    help
      Physical distance between sensor 0 and sensor 1 in millimeters.
      Used to calculate vehicle speed.

config RADAR_SPEED_LIMIT_LIGHT_KMH
    int "Speed limit for light vehicles (km/h)"
    range 30 130
    default 60
    help
      Maximum allowed speed for light vehicles (cars, motorcycles).

config RADAR_SPEED_LIMIT_HEAVY_KMH
    int "Speed limit for heavy vehicles (km/h)"
    range 30 130
    default 40
    help
      Maximum allowed speed for heavy vehicles (trucks, buses).

config RADAR_WARNING_THRESHOLD_PERCENT
    int "Warning threshold percentage"
    range 50 99
    default 90
    help
      Percentage of speed limit that triggers yellow warning status.
      For example, 90% means warning at 54 km/h for a 60 km/h limit.

config RADAR_CAMERA_FAILURE_RATE_PERCENT
    int "Camera failure simulation rate (%)"
    range 0 100
    default 10
    help
      Percentage chance that camera capture will simulate a failure.
      Set to 0 to disable failure simulation.

config RADAR_SPEED_MIN_KMH
    int "Minimum simulated speed (km/h)"
    range 20 80
    default 30
    help
      Minimum speed for random vehicle generation in simulation mode.

config RADAR_SPEED_MAX_KMH
    int "Maximum simulated speed (km/h)"
    range 80 150
    default 120
    help
      Maximum speed for random vehicle generation in simulation mode.

config RADAR_DETECTION_INTERVAL_S
    int "Detection interval (seconds)"
    range 1 30
    default 5
    help
      Time interval between simulated vehicle detections.

endmenu